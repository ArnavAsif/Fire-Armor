{% comment %}
  Section: Futuristic Armory Hero Banner
  File: sections/futuristic-armory-hero.liquid
{% endcomment %}

<style>
/* ============================================================
   ARMORY HERO – EMBEDDED CSS
   ============================================================ */

#armory-hero-{{ section.id }} {
  --accent: {{ section.settings.accent_color }};
  --accent-rgb: 0, 212, 255;
  --accent-glow: rgba(0, 212, 255, 0.4);
  --glass-bg: rgba(8, 15, 30, 0.72);
  --glass-border: rgba(0, 212, 255, 0.18);
  --card-w: 340px;
  --card-h: 130px;
  --trans-speed: {{ section.settings.animation_speed }}ms;

  position: relative;
  width: 100%;
  height: {{ section.settings.hero_height }};
  min-height: 600px;
  max-height: 100vh;
  overflow: hidden;
  background: #050b15;
  font-family: 'Rajdhani', 'Orbitron', 'Segoe UI', system-ui, sans-serif;
  contain: layout style;
}

/* ---------- Background ---------- */
.armory-bg-wrapper {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.armory-bg-layer {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0;
  transform: scale(1.05);
  transition:
    opacity var(--trans-speed) cubic-bezier(0.4, 0, 0.2, 1),
    transform var(--trans-speed) cubic-bezier(0.4, 0, 0.2, 1);
  will-change: opacity, transform;
}

.armory-bg-layer.is-active {
  opacity: 1;
  transform: scale(1);
}

.armory-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    rgba(5, 11, 21, 0.93) 0%,
    rgba(5, 11, 21, 0.76) 38%,
    rgba(5, 11, 21, 0.42) 62%,
    rgba(5, 11, 21, 0.82) 100%
  );
  opacity: var(--overlay-opacity, 0.85);
}

.armory-scanlines {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0, 212, 255, 0.012) 2px,
    rgba(0, 212, 255, 0.012) 4px
  );
  pointer-events: none;
  animation: scanMove 8s linear infinite;
}

.armory-grid-lines {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0, 212, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 212, 255, 0.035) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
}

@keyframes scanMove {
  0%   { background-position: 0 0; }
  100% { background-position: 0 200px; }
}

/* ---------- Inner Layout ---------- */
.armory-inner {
  position: relative;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr 1fr 380px;
  grid-template-rows: 1fr;
  height: 100%;
  max-width: {{ section.settings.content_width }};
  margin: 0 auto;
  padding: 40px 24px 40px 32px;
  gap: 0;
  align-items: center;
  box-sizing: border-box;
}

/* ---------- LEFT PANEL ---------- */
.armory-left {
  display: flex;
  align-items: center;
  padding-right: 32px;
}

.armory-content-wrapper {
  opacity: 0;
  transform: translateX(-30px);
  animation: revealLeft 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
}

@keyframes revealLeft {
  to { opacity: 1; transform: translateX(0); }
}

.armory-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(0, 212, 255, 0.08);
  border: 1px solid rgba(0, 212, 255, 0.28);
  padding: 5px 14px 5px 10px;
  border-radius: 2px;
  margin-bottom: 20px;
  position: relative;
  overflow: hidden;
}

.armory-badge::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.1), transparent);
  animation: badgeSweep 3s ease-in-out infinite;
}

@keyframes badgeSweep {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

.armory-badge__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  animation: dotPulse 1.5s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 8px var(--accent); }
  50% { opacity: 0.5; box-shadow: 0 0 3px var(--accent); }
}

.armory-badge__text {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--accent);
  text-transform: uppercase;
}

.armory-heading {
  font-size: clamp(28px, 3.5vw, 52px);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: #ffffff;
  margin: 0 0 16px;
  text-shadow: 0 0 40px rgba(0, 212, 255, 0.28), 0 2px 4px rgba(0,0,0,0.6);
  transition: opacity 0.35s ease, transform 0.35s ease;
  will-change: opacity, transform;
}

.armory-subheading {
  font-size: clamp(12px, 1.1vw, 15px);
  color: rgba(180, 210, 240, 0.75);
  margin: 0 0 30px;
  line-height: 1.65;
  letter-spacing: 0.04em;
  transition: opacity 0.35s ease;
  will-change: opacity;
}

.armory-cta-wrapper {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.armory-cta-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 28px;
  background: transparent;
  border: 1.5px solid var(--accent);
  color: var(--accent);
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  overflow: hidden;
  transition: color 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
}

.armory-cta-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--accent);
  transform: translateX(-101%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 0;
}

.armory-cta-btn:hover::before { transform: translateX(0); }
.armory-cta-btn:hover { color: #050b15; box-shadow: 0 0 28px rgba(0, 212, 255, 0.45); }
.armory-cta-btn__text, .armory-cta-btn__icon { position: relative; z-index: 1; }

.armory-cta-btn__glow {
  position: absolute;
  inset: -2px;
  background: transparent;
  border: 1px solid var(--accent);
  opacity: 0;
  transform: scale(1.06);
  transition: opacity 0.3s, transform 0.3s;
  pointer-events: none;
}

.armory-cta-btn:hover .armory-cta-btn__glow { opacity: 0.35; transform: scale(1.02); }

.armory-stats { display: flex; align-items: center; gap: 16px; }
.armory-stat { display: flex; flex-direction: column; align-items: center; }
.armory-stat__value { font-size: 20px; font-weight: 800; color: var(--accent); line-height: 1; }
.armory-stat__label { font-size: 9px; letter-spacing: 0.16em; color: rgba(255,255,255,0.38); margin-top: 2px; }
.armory-stat-divider { width: 1px; height: 28px; background: rgba(0, 212, 255, 0.25); }

.armory-hud-lines { display: flex; gap: 6px; margin-top: 30px; }
.armory-hud-lines span { height: 2px; background: var(--accent); border-radius: 1px; animation: hudPulse 2s ease-in-out infinite; }
.armory-hud-lines span:nth-child(1) { width: 40px; }
.armory-hud-lines span:nth-child(2) { width: 20px; animation-delay: 0.3s; }
.armory-hud-lines span:nth-child(3) { width: 10px; animation-delay: 0.6s; }

@keyframes hudPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

/* ---------- CENTER PANEL ---------- */
.armory-center {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 100%;
  width: 100%;
  margin-left: -5%;
}

.armory-featured-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}
@media(min-width: 1024px){
.armory-featured-wrapper {
margin-left: -40%
}
}

.armory-featured-img-wrap {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(20px) scale(0.97);
  transition:
    opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: opacity, transform;
  pointer-events: none;
}

.armory-featured-img-wrap.is-active {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.armory-featured-img-wrap.is-active {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.armory-featured-img-wrap img {
  max-width: 90%;
  max-height: 88%;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
  {% comment %} filter: drop-shadow(0 20px 60px rgba(0, 212, 255, 0.3)); {% endcomment %}
}

@keyframes heroFloat {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

.armory-featured-glow {
  position: absolute;
  bottom: 2%;
  left: 50%;
  transform: translateX(-50%);
  width: 300px;
  height: 60px;
  background: radial-gradient(ellipse, rgba(0, 255, 64, 0.22) 0%, transparent 70%);
  filter: blur(18px);
  animation: glowPulse 4s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.55; transform: translateX(-50%) scaleX(1); }
  50% { opacity: 1; transform: translateX(-50%) scaleX(1.2); }
}

.armory-featured-platform {
  position: absolute;
  bottom: 8%;
  left: 50%;
  transform: translateX(-50%);
  width: 180px;
  height: 6px;
  background: linear-gradient(90deg, transparent, rgba(0, 255, 21, 0.55), transparent);
  border-radius: 50%;
  filter: blur(4px);
}

.armory-scan-ring {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  border: 1px solid rgba(0, 212, 255, 0.08);
  animation: scanRingPulse 4s ease-in-out infinite;
  pointer-events: none;
}

.armory-scan-ring::before, .armory-scan-ring::after {
  content: '';
  position: absolute;
  inset: 22px;
  border-radius: 50%;
  border: 1px solid rgba(0, 212, 255, 0.05);
}
.armory-scan-ring::after { inset: 55px; border-color: rgba(0, 212, 255, 0.03); }

@keyframes scanRingPulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.05); opacity: 0.9; }
}

.armory-corner-tl, .armory-corner-tr, .armory-corner-bl, .armory-corner-br {
  position: absolute; width: 18px; height: 18px; pointer-events: none;
}
.armory-corner-tl { top: 10%; left: 12%; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); }
.armory-corner-tr { top: 10%; right: 12%; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); }
.armory-corner-bl { bottom: 10%; left: 12%; border-bottom: 2px solid var(--accent); border-left: 2px solid var(--accent); }
.armory-corner-br { bottom: 10%; right: 12%; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); }

/* ================================================================
   RIGHT PANEL — REDESIGNED PROFESSIONAL WEAPON CARDS
   ================================================================ */
.armory-right {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding-left: 12px;
  position: relative;
  overflow: hidden;
}

.armory-cards {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-height: 100%;
  overflow: hidden;
}

/* ── CARD BASE ── */
.armory-card {
  position: relative;
  width: 100%;
  max-width: var(--card-w);
  background: linear-gradient(
    135deg,
    rgba(8, 18, 38, 0.88) 0%,
    rgba(12, 24, 50, 0.80) 100%
  );
  border: none;
  outline: none;
  cursor: pointer;
  padding: 0;
  text-align: left;
  border-radius: 4px;
  overflow: hidden;
  opacity: 0;
  transform: translateX(50px);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition:
    transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
    box-shadow 0.35s ease,
    background 0.35s ease;
  will-change: transform, box-shadow;
  clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
}

.armory-card.animate-in {
  animation: cardReveal 0.65s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes cardReveal {
  to { opacity: 1; transform: translateX(0); }
}

.armory-card:hover {
  transform: translateX(-5px) scale(1.018);
  box-shadow:
    0 0 24px rgba(var(--accent-rgb), 0.28),
    0 10px 40px rgba(0,0,0,0.5),
    inset 0 1px 0 rgba(255,255,255,0.04);
}

.armory-card.is-active {
  background: linear-gradient(
    135deg,
    rgba(0, 212, 255, 0.10) 0%,
    rgba(8, 18, 38, 0.90) 100%
  );
  transform: translateX(-3px);
  box-shadow:
    0 0 35px rgba(var(--accent-rgb), 0.38),
    0 0 70px rgba(var(--accent-rgb), 0.12),
    0 12px 40px rgba(0,0,0,0.6),
    inset 0 1px 0 rgba(0, 212, 255, 0.15);
}

/* ── CARD INNER LAYOUT ── */
.armory-card__inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 150px 1fr 34px;
  grid-template-rows: 1fr;
  align-items: stretch;
  gap: 0;
  height: 100%;
  min-height: var(--card-h);
}

/* ── IMAGE SECTION (left column) ── */
.armory-card__img-wrap {
  position: relative;
  width: 150px;
  height: 100%;
  min-height: var(--card-h);
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(
    135deg,
    rgba(0, 20, 40, 0.9) 0%,
    rgba(0, 30, 60, 0.7) 100%
  );
  border-right: 1px solid rgba(0, 212, 255, 0.12);
}

/* Subtle inner glow on image bg */
.armory-card__img-wrap::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse at 50% 60%,
    rgba(var(--accent-rgb), 0.08) 0%,
    transparent 70%
  );
  pointer-events: none;
}

.armory-card__img-wrap img {
  width: 138px;
  height: 88px;
  object-fit: contain;
  object-position: center;
  position: relative;
  z-index: 1;
  user-select: none;
  -webkit-user-drag: none;
  transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), filter 0.45s ease;
  filter: drop-shadow(0 2px 12px rgba(var(--accent-rgb), 0.25));
}

.armory-card:hover .armory-card__img-wrap img {
  transform: scale(1.1) translateX(4px);
  filter: drop-shadow(0 4px 18px rgba(var(--accent-rgb), 0.5)) brightness(1.1);
}

.armory-card.is-active .armory-card__img-wrap img {
  filter: drop-shadow(0 4px 20px rgba(var(--accent-rgb), 0.55)) brightness(1.12);
}

.armory-card__img-placeholder {
  width: 70px;
  height: 44px;
  color: var(--accent, #00d4ff);
  opacity: 0.35;
  z-index: 1;
}

/* ── INFO SECTION (center column) ── */
.armory-card__info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 14px 10px 14px 14px;
  gap: 5px;
  min-width: 0;
  overflow: hidden;
}

/* Serial / index tag */
.armory-card__tag {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
}

.armory-card__index {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--card-accent, var(--accent, #00d4ff));
  background: rgba(var(--accent-rgb), 0.1);
  border: 1px solid rgba(var(--accent-rgb), 0.2);
  padding: 1px 6px;
  border-radius: 1px;
  line-height: 1.6;
  white-space: nowrap;
}

.armory-card__type {
  font-size: 8px;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: rgba(255,255,255,0.35);
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.armory-card__title {
  font-size: 15px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin: 0;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  transition: color 0.3s ease;
}

.armory-card.is-active .armory-card__title,
.armory-card:hover .armory-card__title {
  color: var(--card-accent, var(--accent, #00d4ff));
}

.armory-card__desc {
  font-size: 10px;
  color: rgba(160, 200, 230, 0.65);
  letter-spacing: 0.04em;
  margin: 0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── ACTION SECTION (right column) ── */
.armory-card__action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10px;
  border-left: 1px solid rgba(var(--accent-rgb), 0.1);
  transition: background 0.3s, border-color 0.3s;
  flex-shrink: 0;
}

.armory-card__action-inner {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(var(--accent-rgb), 0.3);
  border-radius: 2px;
  transition: background 0.3s, border-color 0.3s, transform 0.3s;
}

.armory-card__arrow { color: var(--card-accent, var(--accent, #00d4ff)); }

.armory-card:hover .armory-card__action-inner,
.armory-card.is-active .armory-card__action-inner {
  background: var(--card-accent, var(--accent, #00d4ff));
  border-color: var(--card-accent, var(--accent, #00d4ff));
  transform: translateX(2px);
}

.armory-card:hover .armory-card__arrow,
.armory-card.is-active .armory-card__arrow { color: #050b15; }

/* ── DECORATIVE TOP BAR ── */
.armory-card__topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--card-accent, var(--accent, #00d4ff)) 30%,
    var(--card-accent, var(--accent, #00d4ff)) 70%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 5;
}

.armory-card:hover .armory-card__topbar,
.armory-card.is-active .armory-card__topbar { opacity: 1; }

/* ── BORDER OVERLAY ── */
.armory-card__border {
  position: absolute;
  inset: 0;
  border: 1.5px solid rgba(var(--accent-rgb), 0.14);
  border-radius: 4px;
  transition: border-color 0.4s ease;
  pointer-events: none;
  clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
}

.armory-card:hover .armory-card__border {
  border-color: rgba(var(--accent-rgb), 0.45);
}

.armory-card.is-active .armory-card__border {
  border-color: var(--card-accent, var(--accent));
  animation: activeBorderPulse 2.5s ease-in-out infinite;
}

@keyframes activeBorderPulse {
  0%, 100% { border-color: var(--card-accent, var(--accent)); opacity: 1; }
  50% { border-color: rgba(var(--accent-rgb), 0.45); opacity: 0.75; }
}

/* ── GLOW LAYER ── */
.armory-card__glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 30% 50%, rgba(var(--accent-rgb), 0.07) 0%, transparent 65%);
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
}

.armory-card:hover .armory-card__glow,
.armory-card.is-active .armory-card__glow { opacity: 1; }

/* ── SCAN LINE ── */
.armory-card__scan {
  position: absolute;
  top: 0;
  left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb), 0.05), transparent);
  pointer-events: none;
  z-index: 3;
}

.armory-card.is-active .armory-card__scan {
  animation: cardScanLine 3.5s linear infinite;
}

@keyframes cardScanLine {
  0% { left: -60%; }
  100% { left: 160%; }
}

/* ── CORNER ACCENT (top-right) ── */
.armory-card__corner {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-left: 24px solid transparent;
  border-top: 24px solid rgba(var(--accent-rgb), 0.12);
  transition: border-top-color 0.4s ease;
  pointer-events: none;
  z-index: 4;
}

.armory-card.is-active .armory-card__corner {
  border-top-color: rgba(var(--accent-rgb), 0.35);
}

/* ---------- MOBILE CAROUSEL ---------- */
.armory-mobile-carousel {
  display: none;
  position: relative;
  z-index: 10;
  padding: 14px 0 18px;
  background: rgba(5, 11, 21, 0.92);
  border-top: 1px solid rgba(0, 212, 255, 0.14);
}

.armory-mobile-track {
  display: flex;
  gap: 10px;
  padding: 4px 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.armory-mobile-track::-webkit-scrollbar { display: none; }

.armory-mobile-card {
  flex-shrink: 0;
  scroll-snap-align: start;
  width: 130px;
  background: rgba(8, 18, 38, 0.85);
  border: 1.5px solid rgba(0, 212, 255, 0.18);
  border-radius: 3px;
  padding: 8px 8px 10px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
}

.armory-mobile-card img {
  width: 100%;
  height: 60px;
  object-fit: contain;
  filter: drop-shadow(0 2px 6px rgba(0, 212, 255, 0.2));
  user-select: none;
}

.armory-mobile-card.is-active {
  border-color: var(--card-accent, var(--accent, #00d4ff));
  box-shadow: 0 0 16px rgba(0, 212, 255, 0.28);
  background: rgba(0, 212, 255, 0.07);
}

.armory-mobile-card__title {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.85);
  text-transform: uppercase;
  text-align: center;
  line-height: 1.3;
}

.armory-mobile-dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: 12px;
}

.armory-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  cursor: pointer;
  transition: background 0.3s, box-shadow 0.3s, transform 0.3s;
}

.armory-dot.is-active {
  background: var(--accent, #00d4ff);
  box-shadow: 0 0 8px var(--accent, #00d4ff);
  transform: scale(1.35);
}

/* ---------- SWITCHING STATES ---------- */
.armory-content-wrapper.is-switching .armory-heading {
  opacity: 0;
  transform: translateY(-10px);
}
.armory-content-wrapper.is-switching .armory-subheading { opacity: 0; }
.armory-content-wrapper.is-switching .armory-cta-btn { opacity: 0; transform: translateY(6px); }

/* ---------- FOCUS / ACCESSIBILITY ---------- */
.armory-card:focus-visible,
.armory-mobile-card:focus-visible {
  outline: 2px solid var(--accent, #00d4ff);
  outline-offset: 3px;
}

/* ---------- REDUCED MOTION ---------- */
@media (prefers-reduced-motion: reduce) {
  .armory-featured-img-wrap img,
  .armory-scan-ring,
  .armory-badge::before,
  .armory-card__scan,
  .armory-scanlines,
  .armory-featured-glow { animation: none !important; }
  .armory-bg-layer,
  .armory-featured-img-wrap,
  .armory-card { transition-duration: 80ms !important; }
}

/* ---------- TABLET ---------- */
@media (max-width: 1100px) {
  .armory-inner {
    grid-template-columns: 1fr 360px;
    padding: 32px 20px;
  }
  .armory-center { display: none; }
  .armory-right { padding-left: 10px; }
  #armory-hero-{{ section.id }} { --card-w: 360px; }
}

/* ---------- MOBILE ---------- */
@media (max-width: 768px) {
  #armory-hero-{{ section.id }} {
    height: auto !important;
    max-height: none;
    min-height: unset;
  }
  .armory-inner {
    grid-template-columns: 1fr;
    height: auto;
    min-height: 62vw;
    align-items: start;
    padding: 26px 18px 20px;
  }
  .armory-center {
    display: flex;
    position: absolute;
    right: 0;
    top: 0;
    width: 44%;
    height: 100%;
    z-index: 5;
    pointer-events: none;
  }
  .armory-featured-img-wrap img { animation: none !important; }
  .armory-right { display: none; }
  .armory-mobile-carousel { display: block; }
  .armory-left { padding-right: 0; width: 56%; z-index: 6; position: relative; }
  .armory-heading { font-size: clamp(18px, 5vw, 30px); }
  .armory-stats { display: none; }
  .armory-hud-lines { display: none; }
  .armory-badge { margin-bottom: 10px; }
  .armory-subheading { font-size: 11px; margin-bottom: 18px; }
  .armory-cta-btn { padding: 9px 16px; font-size: 10px; }
  .armory-scan-ring { display: none; }
}

@media (max-width: 480px) {
  .armory-center { width: 48%; opacity: 0.65; }
  .armory-left { width: 62%; }
}
</style>


<section
  class="armory-hero"
  id="armory-hero-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --accent-color: {{ section.settings.accent_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --animation-speed: {{ section.settings.animation_speed }}ms;
    --hero-height: {{ section.settings.hero_height }};
  "
  role="region"
  aria-label="Featured Products Armory"
>

  <div class="armory-bg-wrapper" aria-hidden="true">
    {%- for block in section.blocks -%}
      <div
        class="armory-bg-layer{% if forloop.first %} is-active{% endif %}"
        data-bg-index="{{ forloop.index0 }}"
        style="background-image: url('{{ block.settings.background_image | image_url: width: 1920 }}');"
      ></div>
    {%- endfor -%}
    <div class="armory-overlay"></div>
    <div class="armory-scanlines" aria-hidden="true"></div>
    <div class="armory-grid-lines" aria-hidden="true"></div>
  </div>

  <div class="armory-inner">

    <!-- LEFT -->
    <div class="armory-left" aria-live="polite">
      <div class="armory-content-wrapper">
        <div class="armory-badge">
          <span class="armory-badge__dot" aria-hidden="true"></span>
          <span class="armory-badge__text">ACTIVE COLLECTION</span>
        </div>

        <h1 class="armory-heading" id="armory-heading-{{ section.id }}">
          {%- if section.blocks.size > 0 -%}{{ section.blocks.first.settings.title }}{%- else -%}ADVANCED ARMORY{%- endif -%}
        </h1>

        <p class="armory-subheading">
          {%- if section.blocks.size > 0 -%}{{ section.blocks.first.settings.subtitle }}{%- else -%}Next Generation Collection{%- endif -%}
        </p>

        <div class="armory-cta-wrapper">
          <a
            class="armory-cta-btn"
            href="{{ section.blocks.first.settings.cta_link | default: '#' }}"
            aria-label="{{ section.blocks.first.settings.cta_text | default: 'Explore' }}"
          >
            <span class="armory-cta-btn__text">{{ section.blocks.first.settings.cta_text | default: 'EXPLORE NOW' }}</span>
            <span class="armory-cta-btn__icon" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="armory-cta-btn__glow" aria-hidden="true"></span>
          </a>

          <div class="armory-stats" aria-hidden="true">
            <div class="armory-stat">
              <span class="armory-stat__value">{{ section.blocks.size }}</span>
              <span class="armory-stat__label">UNITS</span>
            </div>
            <div class="armory-stat-divider"></div>
            <div class="armory-stat">
              <span class="armory-stat__value">AAA</span>
              <span class="armory-stat__label">GRADE</span>
            </div>
          </div>
        </div>

        <div class="armory-hud-lines" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>

    <!-- CENTER -->
    <div class="armory-center" aria-hidden="true">
      <div class="armory-featured-wrapper">
        <div class="armory-featured-glow"></div>
        <div class="armory-featured-platform"></div>

        {%- for block in section.blocks -%}
          {%- if block.settings.featured_image != blank -%}
            <div
              class="armory-featured-img-wrap{% if forloop.first %} is-active{% endif %}"
              data-featured-index="{{ forloop.index0 }}"
            >
              <img
                src="{{ block.settings.featured_image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.featured_image | image_url: width: 400 }} 400w,
                  {{ block.settings.featured_image | image_url: width: 600 }} 600w,
                  {{ block.settings.featured_image | image_url: width: 800 }} 800w
                "
                sizes="(max-width: 768px) 100vw, 40vw"
                alt="{{ block.settings.title | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="800"
                height="800"
                draggable="false"
              >
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="armory-scan-ring" aria-hidden="true"></div>
        <div class="armory-corner-tl" aria-hidden="true"></div>
        <div class="armory-corner-tr" aria-hidden="true"></div>
        <div class="armory-corner-bl" aria-hidden="true"></div>
        <div class="armory-corner-br" aria-hidden="true"></div>
      </div>
    </div>

    <!-- RIGHT CARDS -->
    <div class="armory-right">
      <div
        class="armory-cards"
        role="tablist"
        aria-label="Weapon Selection"
        id="armory-cards-{{ section.id }}"
      >
        {%- for block in section.blocks -%}
          {%- assign card_accent = block.settings.accent_color | default: section.settings.accent_color -%}
          <button
            class="armory-card{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="armory-panel-{{ section.id }}"
            data-card-index="{{ forloop.index0 }}"
            data-title="{{ block.settings.title | escape }}"
            data-subtitle="{{ block.settings.subtitle | escape }}"
            data-cta-text="{{ block.settings.cta_text | escape }}"
            data-cta-link="{{ block.settings.cta_link }}"
            data-accent="{{ card_accent }}"
            style="--card-accent: {{ card_accent }}; --accent-rgb: {{ card_accent | color_to_rgb | remove: 'rgb(' | remove: ')' }};"
            {{ block.shopify_attributes }}
          >
            <div class="armory-card__inner">

              <!-- Image Column -->
              <div class="armory-card__img-wrap" aria-hidden="true">
                {%- if block.settings.card_thumbnail != blank -%}
                  <img
                    src="{{ block.settings.card_thumbnail | image_url: width: 300 }}"
                    srcset="
                      {{ block.settings.card_thumbnail | image_url: width: 150 }} 150w,
                      {{ block.settings.card_thumbnail | image_url: width: 300 }} 300w
                    "
                    sizes="150px"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="150"
                    height="100"
                    draggable="false"
                  >
                {%- else -%}
                  <div class="armory-card__img-placeholder" aria-hidden="true">
                    <svg viewBox="0 0 60 40" fill="none">
                      <rect x="2" y="15" width="56" height="10" rx="2" fill="currentColor" opacity="0.3"/>
                      <rect x="40" y="10" width="16" height="8" rx="1.5" fill="currentColor" opacity="0.5"/>
                      <circle cx="10" cy="20" r="4" fill="currentColor" opacity="0.4"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>

              <!-- Info Column -->
              <div class="armory-card__info">
                <div class="armory-card__tag">
                  <span class="armory-card__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="armory-card__type">{{ block.settings.subtitle | split: '|' | first | strip | truncate: 18, '' }}</span>
                </div>
                <h3 class="armory-card__title">{{ block.settings.title | default: 'WEAPON' }}</h3>
                <p class="armory-card__desc">{{ block.settings.subtitle | default: '' | truncate: 65 }}</p>
              </div>

              <!-- Arrow Column -->
              <div class="armory-card__action" aria-hidden="true">
                <div class="armory-card__action-inner">
                  <svg class="armory-card__arrow" width="13" height="13" viewBox="0 0 14 14" fill="none">
                    <path d="M2 7H12M12 7L8 3M12 7L8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>

            </div>

            <!-- Decorative Layers -->
            <div class="armory-card__topbar" aria-hidden="true"></div>
            <div class="armory-card__border" aria-hidden="true"></div>
            <div class="armory-card__glow" aria-hidden="true"></div>
            <div class="armory-card__scan" aria-hidden="true"></div>
            <div class="armory-card__corner" aria-hidden="true"></div>

          </button>
        {%- endfor -%}
      </div>
    </div>

  </div>

  <!-- MOBILE CAROUSEL -->
  <div class="armory-mobile-carousel" aria-label="Weapon cards" role="group">
    <div class="armory-mobile-track" id="armory-mobile-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign card_accent = block.settings.accent_color | default: section.settings.accent_color -%}
        <button
          class="armory-mobile-card{% if forloop.first %} is-active{% endif %}"
          data-card-index="{{ forloop.index0 }}"
          data-title="{{ block.settings.title | escape }}"
          data-subtitle="{{ block.settings.subtitle | escape }}"
          data-cta-text="{{ block.settings.cta_text | escape }}"
          data-cta-link="{{ block.settings.cta_link }}"
          data-accent="{{ card_accent }}"
          style="--card-accent: {{ card_accent }};"
          aria-label="{{ block.settings.title | escape }}"
        >
          {%- if block.settings.card_thumbnail != blank -%}
            <img
              src="{{ block.settings.card_thumbnail | image_url: width: 200 }}"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="120"
              height="60"
              draggable="false"
            >
          {%- endif -%}
          <span class="armory-mobile-card__title">{{ block.settings.title | truncate: 22 }}</span>
        </button>
      {%- endfor -%}
    </div>
    <div class="armory-mobile-dots" aria-hidden="true">
      {%- for block in section.blocks -%}
        <span class="armory-dot{% if forloop.first %} is-active{% endif %}" data-dot-index="{{ forloop.index0 }}"></span>
      {%- endfor -%}
    </div>
  </div>

</section>

<script>
(function () {
  'use strict';

  const section = document.getElementById('armory-hero-{{ section.id }}');
  if (!section) return;

  const state = { activeIndex: 0, isTransitioning: false, totalCards: 0 };

  const bgLayers       = section.querySelectorAll('.armory-bg-layer');
  const featuredImgs   = section.querySelectorAll('.armory-featured-img-wrap');
  const desktopCards   = section.querySelectorAll('.armory-card');
  const mobileCards    = section.querySelectorAll('.armory-mobile-card');
  const headingEl      = section.querySelector('.armory-heading');
  const subheadingEl   = section.querySelector('.armory-subheading');
  const ctaBtn         = section.querySelector('.armory-cta-btn');
  const ctaBtnText     = section.querySelector('.armory-cta-btn__text');
  const contentWrapper = section.querySelector('.armory-content-wrapper');
  const mobileDots     = section.querySelectorAll('.armory-dot');
  const transSpeed     = parseInt(getComputedStyle(section).getPropertyValue('--trans-speed')) || 700;

  state.totalCards = desktopCards.length;

  function hexToRgb(hex) {
    const r = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return r ? `${parseInt(r[1],16)}, ${parseInt(r[2],16)}, ${parseInt(r[3],16)}` : '0, 212, 255';
  }

  function setCardActive(card, active) {
    card.classList.toggle('is-active', active);
    card.setAttribute('aria-selected', String(active));
  }

  function switchBanner(index) {
    if (state.isTransitioning || index === state.activeIndex) return;
    state.isTransitioning = true;
    state.activeIndex = index;

    const srcCard = desktopCards[index] || mobileCards[index];
    if (!srcCard) { state.isTransitioning = false; return; }

    const title    = srcCard.dataset.title    || '';
    const subtitle = srcCard.dataset.subtitle || '';
    const ctaText  = srcCard.dataset.ctaText  || '';
    const ctaLink  = srcCard.dataset.ctaLink  || '#';
    const accent   = srcCard.dataset.accent   || '#00d4ff';
    const rgb      = hexToRgb(accent);

    /* Update CSS vars immediately for smooth color shift */
    section.style.setProperty('--accent', accent);
    section.style.setProperty('--accent-color', accent);
    section.style.setProperty('--accent-rgb', rgb);
    section.style.setProperty('--accent-glow', `rgba(${rgb}, 0.4)`);

    /* Fade out text */
    contentWrapper && contentWrapper.classList.add('is-switching');

    const delay = Math.min(transSpeed * 0.38, 280);

    setTimeout(() => {
      /* Swap all visuals */
      bgLayers.forEach((l, i) => l.classList.toggle('is-active', i === index));
      featuredImgs.forEach((img, i) => img.classList.toggle('is-active', i === index));
      desktopCards.forEach((c, i) => setCardActive(c, i === index));
      mobileCards.forEach((c, i) => c.classList.toggle('is-active', i === index));
      mobileDots.forEach((d, i) => d.classList.toggle('is-active', i === index));

      /* Update text */
      if (headingEl)    headingEl.textContent    = title;
      if (subheadingEl) subheadingEl.textContent = subtitle;
      if (ctaBtnText)   ctaBtnText.textContent   = ctaText;
      if (ctaBtn) { ctaBtn.href = ctaLink; ctaBtn.setAttribute('aria-label', ctaText); }

    }, delay);

    /* Fade text back in */
    setTimeout(() => {
      contentWrapper && contentWrapper.classList.remove('is-switching');
      state.isTransitioning = false;
    }, Math.min(transSpeed * 0.62, 480));
  }

  /* Stagger card entrance */
  function initCards() {
    desktopCards.forEach((card, i) => {
      setTimeout(() => card.classList.add('animate-in'), 180 + i * 110);
    });
  }

  /* Desktop events */
  desktopCards.forEach((card, i) => {
    card.addEventListener('click', () => switchBanner(i));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); switchBanner(i); }
      if (e.key === 'ArrowDown') { e.preventDefault(); desktopCards[i + 1]?.focus(); }
      if (e.key === 'ArrowUp')   { e.preventDefault(); desktopCards[i - 1]?.focus(); }
    });
  });

  /* Mobile card events */
  mobileCards.forEach((card, i) => card.addEventListener('click', () => switchBanner(i)));

  /* Dot events */
  mobileDots.forEach((dot, i) => dot.addEventListener('click', () => switchBanner(i)));

  /* Touch swipe */
  const track = section.querySelector('.armory-mobile-track');
  if (track) {
    let sx = 0, sy = 0;
    track.addEventListener('touchstart', e => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    track.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 38) {
        const next = Math.max(0, Math.min(state.totalCards - 1, state.activeIndex + (dx < 0 ? 1 : -1)));
        switchBanner(next);
      }
    }, { passive: true });
  }

  /* Section-level arrow keys */
  section.addEventListener('keydown', (e) => {
    if (document.activeElement.classList.contains('armory-card')) return;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown')
      switchBanner(Math.min(state.totalCards - 1, state.activeIndex + 1));
    if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')
      switchBanner(Math.max(0, state.activeIndex - 1));
  });

  /* Intersection Observer: init when visible */
  new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        initCards();
        section.querySelectorAll('.armory-featured-img-wrap, .armory-bg-layer')
          .forEach(el => el.style.willChange = 'opacity, transform');
        obs.disconnect();
      }
    });
  }, { threshold: 0.08 }).observe(section);

})();
</script>

{% schema %}
{
  "name": "Armory Hero Banner",
  "tag": "section",
  "class": "armory-section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "hero_height",
      "label": "Hero Height",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "90vh", "label": "Large (90vh)" },
        { "value": "80vh", "label": "Medium (80vh)" },
        { "value": "70vh", "label": "Small (70vh)" }
      ],
      "default": "100vh"
    },
    {
      "type": "text",
      "id": "content_width",
      "label": "Content Max Width",
      "default": "1440px"
    },
    {
      "type": "header",
      "content": "Visual Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Default Accent Color",
      "default": "#00d4ff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background Overlay Opacity",
      "min": 50,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Transition Speed",
      "min": 400,
      "max": 1200,
      "step": 100,
      "unit": "ms",
      "default": 700
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Weapon / Banner",
      "settings": [
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image",
          "info": "Recommended: 1920×1080px JPG/WebP"
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "Featured Center Image",
          "info": "Transparent PNG recommended"
        },
        {
          "type": "image_picker",
          "id": "card_thumbnail",
          "label": "Card Weapon Image",
          "info": "Transparent PNG, wide format (e.g. 400×200px). Image will display at full card width."
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Weapon Name",
          "default": "SR-10 STORM"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Description / Specs",
          "default": "Sniper Rifle | Long Barrel | Range: 3AM | Kinetic Accelerator"
        },
        {
          "type": "header",
          "content": "Call to Action"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text",
          "default": "VIEW WEAPON"
        },
        {
