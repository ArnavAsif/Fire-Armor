{% comment %}
  Section: Armory Tactical Features
  File: sections/armory-tactical-features.liquid
{% endcomment %}

<style>
/* ============================================================
   ARMORY TACTICAL FEATURES – LIGHT SECTION
   ============================================================ */

#atf-{{ section.id }} {
  --atf-accent: {{ section.settings.accent_color }};
  --atf-accent-rgb: 0, 212, 255;
  --atf-bg: {{ section.settings.bg_color }};
  --atf-font: 'Rajdhani', 'Orbitron', 'Segoe UI', system-ui, sans-serif;

  position: relative;
  width: 100%;
  background: var(--atf-bg);
  padding: {{ section.settings.section_padding }}px 24px;
  font-family: var(--atf-font);
  overflow: hidden;
  box-sizing: border-box;
}

/* ── Light grid overlay ── */
#atf-{{ section.id }}::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,0,0,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,0.04) 1px, transparent 1px);
  background-size: 40px 40px;
  pointer-events: none;
  z-index: 0;
}

/* ── Diagonal light sweep ── */
#atf-{{ section.id }}::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -20%;
  width: 60%;
  height: 200%;
  background: linear-gradient(
    105deg,
    transparent 0%,
    rgba(var(--atf-accent-rgb), 0.025) 40%,
    rgba(var(--atf-accent-rgb), 0.06) 50%,
    rgba(var(--atf-accent-rgb), 0.025) 60%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 0;
  animation: atfDiagSweep 12s ease-in-out infinite;
}

@keyframes atfDiagSweep {
  0%, 100% { left: -20%; opacity: 0.5; }
  50% { left: 80%; opacity: 1; }
}

/* ── Top accent bar ── */
.atf-top-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--atf-accent) 30%,
    rgba(var(--atf-accent-rgb), 0.4) 70%,
    transparent 100%
  );
  z-index: 2;
}

/* ── Bottom accent bar ── */
.atf-bottom-bar {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(0,0,0,0.1) 30%,
    rgba(0,0,0,0.15) 50%,
    rgba(0,0,0,0.1) 70%,
    transparent 100%
  );
  z-index: 2;
}

/* ── HUD corner decorations ── */
.atf-corner {
  position: absolute;
  width: 18px; height: 18px;
  pointer-events: none;
  z-index: 3;
  opacity: 0.25;
}

.atf-corner--tl { top: 14px; left: 14px; border-top: 2px solid var(--atf-accent); border-left: 2px solid var(--atf-accent); }
.atf-corner--tr { top: 14px; right: 14px; border-top: 2px solid var(--atf-accent); border-right: 2px solid var(--atf-accent); }
.atf-corner--bl { bottom: 14px; left: 14px; border-bottom: 2px solid var(--atf-accent); border-left: 2px solid var(--atf-accent); }
.atf-corner--br { bottom: 14px; right: 14px; border-bottom: 2px solid var(--atf-accent); border-right: 2px solid var(--atf-accent); }

/* ============================================================
   INNER WRAPPER
   ============================================================ */
.atf-inner {
  position: relative;
  z-index: 2;
  max-width: {{ section.settings.content_width }};
  margin: 0 auto;
  box-sizing: border-box;
}

/* ============================================================
   SECTION HEADER
   ============================================================ */
.atf-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 14px;
  margin-bottom: 60px;
}

.atf-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(var(--atf-accent-rgb), 0.08);
  border: 1px solid rgba(var(--atf-accent-rgb), 0.25);
  padding: 5px 14px 5px 10px;
  border-radius: 2px;
  position: relative;
  overflow: hidden;
  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
}

.atf-badge::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(var(--atf-accent-rgb), 0.1), transparent);
  animation: atfBadgeSweep 4s ease-in-out infinite;
}

@keyframes atfBadgeSweep {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

.atf-badge__dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--atf-accent);
  box-shadow: 0 0 8px var(--atf-accent);
  animation: atfDotPulse 1.8s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes atfDotPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.atf-badge__text {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--atf-accent);
  text-transform: uppercase;
  position: relative;
  z-index: 1;
}

.atf-title {
  font-size: clamp(28px, 3.5vw, 52px);
  font-weight: 800;
  color: #0a1628;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  margin: 0;
  line-height: 1.05;
}

.atf-title mark {
  background: none;
  color: var(--atf-accent);
  position: relative;
}

/* Underline on accent word */
.atf-title mark::after {
  content: '';
  position: absolute;
  bottom: -3px;
  left: 0; right: 0;
  height: 3px;
  background: var(--atf-accent);
  border-radius: 2px;
  opacity: 0.4;
}

.atf-subtitle {
  font-size: 14px;
  color: rgba(10,22,40,0.55);
  letter-spacing: 0.06em;
  line-height: 1.7;
  max-width: 560px;
  margin: 0;
}

/* Header divider */
.atf-header__divider {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  max-width: 200px;
}

.atf-header__divider-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(var(--atf-accent-rgb), 0.4));
}

.atf-header__divider-line:last-child {
  background: linear-gradient(90deg, rgba(var(--atf-accent-rgb), 0.4), transparent);
}

.atf-header__divider-diamond {
  width: 6px; height: 6px;
  background: var(--atf-accent);
  transform: rotate(45deg);
  box-shadow: 0 0 8px var(--atf-accent);
  flex-shrink: 0;
}

/* ============================================================
   LAYOUT: LEFT CONTENT + RIGHT FEATURE CARDS
   ============================================================ */
.atf-layout {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 60px;
  align-items: center;
}

/* ── LEFT: Big stat panel ── */
.atf-left {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

/* Main image / product showcase */
.atf-showcase {
  position: relative;
  background: linear-gradient(135deg, #0a1628 0%, #111e3a 100%);
  border-radius: 4px;
  padding: 32px 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 260px;
  overflow: hidden;
  clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
}

/* Showcase grid bg */
.atf-showcase::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,212,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,0.04) 1px, transparent 1px);
  background-size: 30px 30px;
}

/* Showcase glow */
.atf-showcase::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 70%;
  height: 60px;
  background: radial-gradient(ellipse, rgba(var(--atf-accent-rgb), 0.2) 0%, transparent 70%);
  filter: blur(16px);
}

/* HUD corners on showcase */
.atf-showcase__corner {
  position: absolute;
  width: 14px; height: 14px;
  pointer-events: none;
  z-index: 3;
}

.atf-showcase__corner--tl { top: 10px; left: 10px; border-top: 1.5px solid var(--atf-accent); border-left: 1.5px solid var(--atf-accent); opacity: 0.7; }
.atf-showcase__corner--tr { top: 10px; right: 10px; border-top: 1.5px solid var(--atf-accent); border-right: 1.5px solid var(--atf-accent); opacity: 0.7; }
.atf-showcase__corner--bl { bottom: 10px; left: 10px; border-bottom: 1.5px solid var(--atf-accent); border-left: 1.5px solid var(--atf-accent); opacity: 0.7; }
.atf-showcase__corner--br { bottom: 10px; right: 10px; border-bottom: 1.5px solid var(--atf-accent); border-right: 1.5px solid var(--atf-accent); opacity: 0.7; }

.atf-showcase__img {
  position: relative;
  z-index: 2;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 8px 32px rgba(var(--atf-accent-rgb), 0.35));
  {% comment %} animation: atfFloat 6s ease-in-out infinite; {% endcomment %}
  user-select: none;
}

@keyframes atfFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.atf-showcase__placeholder {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0,212,255,0.2);
}

/* Scan ring */
.atf-showcase__ring {
  position: absolute;
  width: 180px; height: 180px;
  border-radius: 50%;
  border: 1px solid rgba(0,212,255,0.08);
  animation: atfRingPulse 4s ease-in-out infinite;
  z-index: 1;
}

@keyframes atfRingPulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.06); opacity: 0.9; }
}

/* Showcase label */
.atf-showcase__label {
  position: absolute;
  bottom: 14px; left: 14px;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.atf-showcase__label-tag {
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: rgba(0,212,255,0.5);
  text-transform: uppercase;
}

.atf-showcase__label-text {
  font-size: 12px;
  font-weight: 800;
  color: #fff;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ── Big metrics row ── */
.atf-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  background: rgba(var(--atf-accent-rgb), 0.08);
  border: 1px solid rgba(var(--atf-accent-rgb), 0.15);
  border-radius: 4px;
  overflow: hidden;
  clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
}

.atf-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18px 12px;
  background: rgba(255,255,255,0.6);
  gap: 4px;
  position: relative;
  transition: background 0.25s ease;
}

.atf-metric:hover { background: rgba(255,255,255,0.85); }

.atf-metric + .atf-metric {
  border-left: 1px solid rgba(var(--atf-accent-rgb), 0.12);
}

.atf-metric__val {
  font-size: 22px;
  font-weight: 800;
  color: var(--atf-accent);
  line-height: 1;
  text-shadow: 0 0 16px rgba(var(--atf-accent-rgb), 0.3);
}

.atf-metric__label {
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: rgba(10,22,40,0.45);
  text-transform: uppercase;
  text-align: center;
}

/* ── CTA buttons ── */
.atf-cta-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.atf-cta-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 24px;
  background: var(--atf-accent);
  border: none;
  color: #050b15;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  font-family: var(--atf-font);
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.3s ease, transform 0.2s ease;
  clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
}

.atf-cta-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transform: translateX(-100%);
  transition: transform 0.5s ease;
}

.atf-cta-primary:hover {
  box-shadow: 0 0 28px rgba(var(--atf-accent-rgb), 0.5), 0 8px 24px rgba(0,0,0,0.15);
  transform: translateY(-2px);
}

.atf-cta-primary:hover::before { transform: translateX(100%); }
.atf-cta-primary:active { transform: translateY(0); }

.atf-cta-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: transparent;
  border: 1.5px solid rgba(10,22,40,0.2);
  color: rgba(10,22,40,0.7);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  font-family: var(--atf-font);
  transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
}

.atf-cta-secondary:hover {
  color: var(--atf-accent);
  border-color: rgba(var(--atf-accent-rgb), 0.4);
  background: rgba(var(--atf-accent-rgb), 0.05);
}

/* ============================================================
   RIGHT: FEATURE CARDS GRID
   ============================================================ */
.atf-right {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ── Feature card ── */
.atf-feature-card {
  position: relative;
  background: #ffffff;
  border-radius: 4px;
  padding: 22px 22px 22px 24px;
  display: grid;
  grid-template-columns: 54px 1fr auto;
  gap: 18px;
  align-items: center;
  overflow: hidden;
  border: 1px solid rgba(10,22,40,0.07);
  box-shadow: 0 2px 12px rgba(10,22,40,0.06);
  transition:
    transform 0.3s cubic-bezier(0.4,0,0.2,1),
    box-shadow 0.3s ease,
    border-color 0.3s ease;
  cursor: default;
  opacity: 0;
  transform: translateX(30px);
  clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
}

.atf-feature-card.is-visible {
  animation: atfCardIn 0.55s cubic-bezier(0.4,0,0.2,1) forwards;
}

@keyframes atfCardIn {
  to { opacity: 1; transform: translateX(0); }
}

.atf-feature-card:hover {
  transform: translateX(-4px);
  box-shadow: 0 8px 32px rgba(10,22,40,0.12),
    -4px 0 0 var(--card-color, var(--atf-accent));
  border-color: rgba(var(--atf-accent-rgb), 0.2);
}

/* Left accent stripe */
.atf-feature-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--card-color, var(--atf-accent));
  border-radius: 0 2px 2px 0;
  transition: width 0.3s ease;
}

.atf-feature-card:hover::before { width: 4px; }

/* Top-right corner triangle */
.atf-feature-card::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  border-left: 20px solid transparent;
  border-top: 20px solid rgba(var(--atf-accent-rgb), 0.08);
  pointer-events: none;
}

/* Scan line on hover */
.atf-feature-card__scan {
  position: absolute;
  top: 0; left: -100%;
  width: 40%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(var(--atf-accent-rgb), 0.04), transparent);
  pointer-events: none;
  transition: none;
}

.atf-feature-card:hover .atf-feature-card__scan {
  animation: atfFeatureScan 1.2s ease-in-out;
}

@keyframes atfFeatureScan {
  0% { left: -40%; }
  100% { left: 140%; }
}

/* ── Icon box ── */
.atf-feature-card__icon {
  width: 54px;
  height: 54px;
  border-radius: 3px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(var(--atf-accent-rgb), 0.07);
  border: 1px solid rgba(var(--atf-accent-rgb), 0.18);
  color: var(--card-color, var(--atf-accent));
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
}

.atf-feature-card:hover .atf-feature-card__icon {
  background: rgba(var(--atf-accent-rgb), 0.12);
  border-color: rgba(var(--atf-accent-rgb), 0.4);
  box-shadow: 0 0 16px rgba(var(--atf-accent-rgb), 0.2);
}

/* Icon number watermark */
.atf-feature-card__icon-num {
  position: absolute;
  bottom: 1px;
  right: 3px;
  font-size: 8px;
  font-weight: 800;
  color: rgba(var(--atf-accent-rgb), 0.3);
  letter-spacing: 0.05em;
  line-height: 1;
}

/* ── Text content ── */
.atf-feature-card__body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.atf-feature-card__tag {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--card-color, var(--atf-accent));
  text-transform: uppercase;
  opacity: 0.7;
}

.atf-feature-card__title {
  font-size: 18px;
  font-weight: 800;
  color: #0a1628;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin: 0;
  line-height: 1.2;
}

.atf-feature-card__desc {
  font-size: 14px;
  color: rgba(10,22,40,0.5);
  line-height: 1.6;
  letter-spacing: 0.03em;
  margin: 0;
}

/* ── Right: stat pill ── */
.atf-feature-card__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 10px 14px;
  background: rgba(var(--atf-accent-rgb), 0.05);
  border: 1px solid rgba(var(--atf-accent-rgb), 0.15);
  border-radius: 3px;
  flex-shrink: 0;
  clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
}

.atf-feature-card__stat-val {
  font-size: 16px;
  font-weight: 800;
  color: var(--card-color, var(--atf-accent));
  line-height: 1;
  white-space: nowrap;
}

.atf-feature-card__stat-label {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: rgba(10,22,40,0.35);
  text-transform: uppercase;
  white-space: nowrap;
}

/* ============================================================
   BOTTOM TRUST STRIP
   ============================================================ */
.atf-trust-strip {
  position: relative;
  z-index: 2;
  margin-top: 56px;
  padding-top: 40px;
  border-top: 1px solid rgba(10,22,40,0.08);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.atf-trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  text-align: center;
  padding: 24px 16px;
  background: #ffffff;
  border: 1px solid rgba(10,22,40,0.07);
  border-radius: 4px;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
  opacity: 0;
  transform: translateY(20px);
}

.atf-trust-item.is-visible {
  animation: atfTrustIn 0.5s cubic-bezier(0.4,0,0.2,1) forwards;
}

@keyframes atfTrustIn {
  to { opacity: 1; transform: translateY(0); }
}

.atf-trust-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(10,22,40,0.1);
  border-color: rgba(var(--atf-accent-rgb), 0.2);
}

/* Top accent line */
.atf-trust-item::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--atf-accent), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.atf-trust-item:hover::before { opacity: 1; }

.atf-trust-item__icon {
  width: 48px; height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(var(--atf-accent-rgb), 0.07);
  border: 1px solid rgba(var(--atf-accent-rgb), 0.18);
  border-radius: 3px;
  color: var(--atf-accent);
  transition: background 0.3s ease, box-shadow 0.3s ease;
  clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px));
}

.atf-trust-item:hover .atf-trust-item__icon {
  background: rgba(var(--atf-accent-rgb), 0.12);
  box-shadow: 0 0 14px rgba(var(--atf-accent-rgb), 0.2);
}

.atf-trust-item__title {
  font-size: 18px;
  font-weight: 800;
  color: #0a1628;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin: 0;
  line-height: 1.2;
}

.atf-trust-item__desc {
  font-size: 14px;
  color: rgba(10,22,40,0.45);
  line-height: 1.6;
  letter-spacing: 0.03em;
  margin: 0;
}

.atf-trust-item__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: var(--atf-accent);
  text-transform: uppercase;
  background: rgba(var(--atf-accent-rgb), 0.07);
  border: 1px solid rgba(var(--atf-accent-rgb), 0.18);
  padding: 3px 8px;
  border-radius: 2px;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1100px) {
  .atf-layout {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .atf-left {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }
  .atf-showcase { grid-column: 1 / -1; }
  .atf-trust-strip { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  #atf-{{ section.id }} { padding: 48px 20px; }
  .atf-layout { gap: 32px; }
  .atf-left { grid-template-columns: 1fr; }
  .atf-feature-card {
    grid-template-columns: 48px 1fr;
    grid-template-rows: auto auto;
  }
  .atf-feature-card__stat {
    grid-column: 2;
    grid-row: 2;
    justify-self: start;
  }
  .atf-trust-strip { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .atf-metrics { grid-template-columns: repeat(3, 1fr); }
  .atf-cta-row { flex-direction: column; }
  .atf-cta-primary, .atf-cta-secondary { width: 100%; justify-content: center; }
  .atf-header { margin-bottom: 40px; }
}

@media (max-width: 480px) {
  #atf-{{ section.id }} { padding: 40px 16px; }
  .atf-trust-strip { grid-template-columns: 1fr; gap: 10px; }
  .atf-feature-card { grid-template-columns: 44px 1fr; }
  .atf-title { font-size: 26px; }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .atf-showcase__img,
  .atf-showcase__ring,
  .atf-badge::before,
  #atf-{{ section.id }}::after { animation: none !important; }
  .atf-feature-card,
  .atf-trust-item { transition-duration: 80ms !important; }
}

/* Focus */
.atf-cta-primary:focus-visible,
.atf-cta-secondary:focus-visible {
  outline: 2px solid var(--atf-accent);
  outline-offset: 2px;
}
</style>


<section
  id="atf-{{ section.id }}"
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.title }}"
>
  {%- comment -%} Decorative elements {%- endcomment -%}
  <div class="atf-top-bar"    aria-hidden="true"></div>
  <div class="atf-bottom-bar" aria-hidden="true"></div>
  <div class="atf-corner atf-corner--tl" aria-hidden="true"></div>
  <div class="atf-corner atf-corner--tr" aria-hidden="true"></div>
  <div class="atf-corner atf-corner--bl" aria-hidden="true"></div>
  <div class="atf-corner atf-corner--br" aria-hidden="true"></div>

  <div class="atf-inner">

    {%- comment -%} ── SECTION HEADER ── {%- endcomment -%}
    <div class="atf-header">
      {%- if section.settings.badge != blank -%}
        <div class="atf-badge">
          <span class="atf-badge__dot" aria-hidden="true"></span>
          <span class="atf-badge__text">{{ section.settings.badge }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="atf-title">
          {{- section.settings.title | replace: section.settings.title_accent, '<mark>' | append: '</mark>' -}}
        </h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="atf-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="atf-header__divider" aria-hidden="true">
        <div class="atf-header__divider-line"></div>
        <div class="atf-header__divider-diamond"></div>
        <div class="atf-header__divider-line"></div>
      </div>
    </div>

    {%- comment -%} ── MAIN LAYOUT ── {%- endcomment -%}
    <div class="atf-layout">

      {%- comment -%} LEFT PANEL {%- endcomment -%}
      <div class="atf-left">

        {%- comment -%} Showcase image {%- endcomment -%}
        <div class="atf-showcase" aria-hidden="true">
          <div class="atf-showcase__corner atf-showcase__corner--tl"></div>
          <div class="atf-showcase__corner atf-showcase__corner--tr"></div>
          <div class="atf-showcase__corner atf-showcase__corner--bl"></div>
          <div class="atf-showcase__corner atf-showcase__corner--br"></div>
          <div class="atf-showcase__ring"></div>

          {%- if section.settings.showcase_image != blank -%}
            <img
              class="atf-showcase__img"
              src="{{ section.settings.showcase_image | image_url: width: 600 }}"
              srcset="
                {{ section.settings.showcase_image | image_url: width: 300 }} 300w,
                {{ section.settings.showcase_image | image_url: width: 600 }} 600w
              "
              sizes="(max-width: 768px) 100vw, 40vw"
              alt="{{ section.settings.showcase_label }}"
              loading="lazy"
              width="300"
              height="200"
              draggable="false"
            >
          {%- else -%}
            <div class="atf-showcase__placeholder">
              <svg width="80" height="52" viewBox="0 0 80 52" fill="none">
                <rect x="2" y="20" width="76" height="12" rx="3" fill="currentColor" opacity="0.15"/>
                <rect x="55" y="14" width="22" height="10" rx="2" fill="currentColor" opacity="0.25"/>
                <circle cx="14" cy="26" r="7" fill="currentColor" opacity="0.15"/>
                <circle cx="14" cy="26" r="3" fill="currentColor" opacity="0.3"/>
              </svg>
            </div>
          {%- endif -%}

          {%- if section.settings.showcase_label != blank -%}
            <div class="atf-showcase__label">
              <span class="atf-showcase__label-tag">FEATURED</span>
              <span class="atf-showcase__label-text">{{ section.settings.showcase_label }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Metrics {%- endcomment -%}
        {%- if section.settings.show_metrics -%}
          <div class="atf-metrics" role="list" aria-label="Key statistics">
            {%- if section.settings.metric_1_val != blank -%}
              <div class="atf-metric" role="listitem">
                <span class="atf-metric__val">{{ section.settings.metric_1_val }}</span>
                <span class="atf-metric__label">{{ section.settings.metric_1_label }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.metric_2_val != blank -%}
              <div class="atf-metric" role="listitem">
                <span class="atf-metric__val">{{ section.settings.metric_2_val }}</span>
                <span class="atf-metric__label">{{ section.settings.metric_2_label }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.metric_3_val != blank -%}
              <div class="atf-metric" role="listitem">
                <span class="atf-metric__val">{{ section.settings.metric_3_val }}</span>
                <span class="atf-metric__label">{{ section.settings.metric_3_label }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} CTA buttons {%- endcomment -%}
        <div class="atf-cta-row">
          {%- if section.settings.cta_primary_text != blank -%}
            <a
              class="atf-cta-primary"
              href="{{ section.settings.cta_primary_link | default: '#' }}"
            >
              {{ section.settings.cta_primary_text }}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
