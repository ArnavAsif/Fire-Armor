          {%- endif -%}
          {%- if section.settings.cta_secondary_text != blank -%}
            <a
              class="atf-cta-secondary"
              href="{{ section.settings.cta_secondary_link | default: '#' }}"
            >
              {{ section.settings.cta_secondary_text }}
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>

      </div>

      {%- comment -%} RIGHT: FEATURE CARDS {%- endcomment -%}
      <div class="atf-right">
        {%- assign accent_cycle = 'cyan,purple,orange,green,red,blue,gold,teal' | split: ',' -%}
        {%- assign color_map = '#00d4ff,#b44dff,#ff8c1a,#00ff88,#ff3d5a,#4d9fff,#ffd700,#00ffcc' | split: ',' -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            {%- assign ci = forloop.index0 | modulo: 8 -%}
            {%- assign this_color = color_map[ci] -%}
            {%- assign display_num = forloop.index | prepend: '0' | slice: -2, 2 -%}

            <div
              class="atf-feature-card"
              data-card-index="{{ forloop.index0 }}"
              style="--card-color: {{ block.settings.accent_override | default: this_color }};"
              {{ block.shopify_attributes }}
            >
              <div class="atf-feature-card__scan" aria-hidden="true"></div>

              {%- comment -%} Icon {%- endcomment -%}
              <div class="atf-feature-card__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2L4 6v6c0 5.25 3.75 10.15 8 11.2C16.25 22.15 20 17.25 20 12V6z"/>
                    </svg>
                  {%- when 'bolt' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H13z"/>
                    </svg>
                  {%- when 'target' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <circle cx="12" cy="12" r="6"/>
                      <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"/>
                    </svg>
                  {%- when 'star' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  {%- when 'truck' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="3" width="15" height="13" rx="1"/>
                      <path d="M16 8h4l3 5v4h-7V8z"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                  {%- when 'lock' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="11" width="18" height="11" rx="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                  {%- when 'award' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="8" r="6"/>
                      <path d="M8.21 13.89L7 22l5-3 5 3-1.21-8.12"/>
                    </svg>
                  {%- when 'cpu' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="4" y="4" width="16" height="16" rx="2"/>
                      <rect x="9" y="9" width="6" height="6"/>
                      <line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
                      <line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
                      <line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/>
                      <line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>
                    </svg>
                  {%- else -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                {%- endcase -%}
                <span class="atf-feature-card__icon-num">{{ display_num }}</span>
              </div>

              {%- comment -%} Body {%- endcomment -%}
              <div class="atf-feature-card__body">
                {%- if block.settings.tag != blank -%}
                  <span class="atf-feature-card__tag">{{ block.settings.tag }}</span>
                {%- endif -%}
                <h3 class="atf-feature-card__title">{{ block.settings.title | default: 'Feature' }}</h3>
                {%- if block.settings.desc != blank -%}
                  <p class="atf-feature-card__desc">{{ block.settings.desc }}</p>
                {%- endif -%}
              </div>

              {%- comment -%} Stat pill {%- endcomment -%}
              {%- if block.settings.stat_val != blank -%}
                <div class="atf-feature-card__stat" aria-label="{{ block.settings.stat_val }} {{ block.settings.stat_label }}">
                  <span class="atf-feature-card__stat-val">{{ block.settings.stat_val }}</span>
