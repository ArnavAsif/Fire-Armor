  <div class="aci-fade-top"       aria-hidden="true"></div>
  <div class="aci-fade-bottom"    aria-hidden="true"></div>
  <div class="aci-fade-left"      aria-hidden="true"></div>
  <div class="aci-fade-right"     aria-hidden="true"></div>
  <div class="aci-hud-corner aci-hud-corner--tl" aria-hidden="true"></div>
  <div class="aci-hud-corner aci-hud-corner--tr" aria-hidden="true"></div>
  <div class="aci-hud-corner aci-hud-corner--bl" aria-hidden="true"></div>
  <div class="aci-hud-corner aci-hud-corner--br" aria-hidden="true"></div>

  {%- comment -%} ── SECTION HEADER ── {%- endcomment -%}
