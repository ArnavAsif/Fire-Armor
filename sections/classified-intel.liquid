      <div class="aci-track aci-track--fwd">
        {%- for i in (1..3) -%}
          {%- if section.settings.row1_text != blank -%}
            {%- assign row1_items = section.settings.row1_text | split: '|' -%}
            {%- for item in row1_items -%}
              <span class="aci-item aci-item--{{ section.settings.row1_color }}{% if forloop.index == 2 or forloop.index == 5 %} aci-item--highlight{% endif %}">
                <span class="aci-item__text">{{ item | strip }}</span>
                <span class="aci-item__sep">
                  {%- if section.settings.row1_sep == 'dot' -%}
                    <span class="aci-sep--dot"></span>
                  {%- elsif section.settings.row1_sep == 'diamond' -%}
                    <span class="aci-sep--diamond" style="color:var(--aci-accent)"></span>
                  {%- elsif section.settings.row1_sep == 'slash' -%}
                    <span class="aci-sep--slash">/</span>
                  {%- elsif section.settings.row1_sep == 'line' -%}
                    <span class="aci-sep--line"></span>
                  {%- else -%}
                    <span class="aci-sep--chevron">›</span>
                  {%- endif -%}
                </span>
              </span>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ══ ROW 2 – Stats/Specs (medium, reverse) ══ {%- endcomment -%}
    <div class="aci-row" style="--row-font-size: {{ section.settings.row2_size }}px; --row-speed: {{ section.settings.row2_speed }}s;">
      <div class="aci-track aci-track--rev">
        {%- for i in (1..3) -%}
          {%- if section.settings.row2_text != blank -%}
            {%- assign row2_items = section.settings.row2_text | split: '|' -%}
            {%- for item in row2_items -%}
              <span class="aci-item aci-item--{{ section.settings.row2_color }}{% if forloop.index == 3 %} aci-item--classified{% endif %}">
                <span class="aci-item__text">{{ item | strip }}</span>
                <span class="aci-item__sep">
                  {%- if section.settings.row2_sep == 'dot' -%}
                    <span class="aci-sep--dot"></span>
                  {%- elsif section.settings.row2_sep == 'diamond' -%}
                    <span class="aci-sep--diamond" style="color:var(--aci-accent)"></span>
                  {%- elsif section.settings.row2_sep == 'line' -%}
                    <span class="aci-sep--line"></span>
                  {%- elsif section.settings.row2_sep == 'chevron' -%}
                    <span class="aci-sep--chevron">›</span>
                  {%- else -%}
                    <span class="aci-sep--slash">/</span>
                  {%- endif -%}
                </span>
              </span>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ══ ROW 3 – Awards/Features (small, forward) ══ {%- endcomment -%}
    <div class="aci-row" style="--row-font-size: {{ section.settings.row3_size }}px; --row-speed: {{ section.settings.row3_speed }}s;">
      <div class="aci-track aci-track--fwd">
        {%- for i in (1..3) -%}
          {%- if section.settings.row3_text != blank -%}
            {%- assign row3_items = section.settings.row3_text | split: '|' -%}
            {%- for item in row3_items -%}
              <span class="aci-item aci-item--{{ section.settings.row3_color }}{% if forloop.index == 1 or forloop.index == 4 %} aci-item--new{% endif %}">
                <span class="aci-item__text">{{ item | strip }}</span>
                <span class="aci-item__sep">
                  {%- if section.settings.row3_sep == 'diamond' -%}
                    <span class="aci-sep--diamond" style="color:var(--aci-accent)"></span>
                  {%- elsif section.settings.row3_sep == 'line' -%}
                    <span class="aci-sep--line"></span>
                  {%- elsif section.settings.row3_sep == 'chevron' -%}
                    <span class="aci-sep--chevron">›</span>
                  {%- elsif section.settings.row3_sep == 'slash' -%}
                    <span class="aci-sep--slash">/</span>
                  {%- else -%}
                    <span class="aci-sep--dot"></span>
                  {%- endif -%}
                </span>
              </span>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
