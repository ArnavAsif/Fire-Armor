<script>
(function () {
  'use strict';

  const section = document.getElementById('aci-{{ section.id }}');
  if (!section) return;

  /* ── Accent RGB sync ── */
  function hexToRgb(hex) {
    const r = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return r
      ? `${parseInt(r[1],16)}, ${parseInt(r[2],16)}, ${parseInt(r[3],16)}`
      : '0, 212, 255';
  }

  const accent = getComputedStyle(section).getPropertyValue('--aci-accent').trim();
  if (accent) section.style.setProperty('--aci-accent-rgb', hexToRgb(accent));

  /* ── Pause marquee on reduced motion ── */
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    section.querySelectorAll('.aci-track').forEach(t => {
      t.style.animation = 'none';
    });
  }

  /* ── Glowing row intersection observer ── */
  const glowRows = section.querySelectorAll('.aci-row--glowing');
  if (glowRows.length) {
    const rowObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        e.target.style.opacity = e.isIntersecting ? '1' : '0.4';
      });
    }, { threshold: 0.5 });
    glowRows.forEach(r => rowObs.observe(r));
  }

  /* ── Animated number counters ── */
  function animateCounter(el) {
    const raw    = el.dataset.count || '';
    const num    = parseFloat(raw.replace(/[^0-9.]/g, ''));
    const suffix = raw.replace(/[0-9.]/g, '');
    if (isNaN(num) || num === 0) return;

    const duration = 1800;
    const start    = performance.now();
    const isFloat  = raw.includes('.');

    function tick(now) {
      const elapsed  = Math.min(now - start, duration);
      const progress = elapsed / duration;
      const eased    = 1 - Math.pow(1 - progress, 3);
      const current  = num * eased;
      el.textContent = (isFloat ? current.toFixed(1) : Math.round(current)) + suffix;
      if (elapsed < duration) requestAnimationFrame(tick);
      else el.textContent = raw;
    }

    requestAnimationFrame(tick);
  }

  const statVals = section.querySelectorAll('.aci-stat__val[data-count]');
  if (statVals.length) {
    const statObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          animateCounter(e.target);
          statObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    statVals.forEach(v => statObs.observe(v));
  }

  /* ── Terminal typewriter (re-runs on scroll into view) ── */
  const terminal = section.querySelector('.aci-terminal__panel');
  if (terminal) {
    const termObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const lines = terminal.querySelectorAll('.aci-terminal__line');
          lines.forEach((line, i) => {
            line.style.animation = 'none';
            line.style.opacity   = '0';
            requestAnimationFrame(() => {
              setTimeout(() => {
                line.style.animation = '';
                line.style.animationDelay = `${0.2 + i * 0.3}s`;
                line.style.animationFillMode = 'forwards';
              }, 50);
            });
          });
          termObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.3 });
    termObs.observe(terminal);
  }

  /* ── Random flicker on classified items ── */
  const classifiedItems = section.querySelectorAll('.aci-item--classified .aci-item__text');
  classifiedItems.forEach(item => {
    setInterval(() => {
      if (Math.random() > 0.85) {
        item.style.opacity = '0.05';
        setTimeout(() => { item.style.opacity = ''; }, 80);
      }
    }, 2000);
  });

})();
</script>

