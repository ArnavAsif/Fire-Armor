              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ══ ROW 5 – Live products from collection ══ {%- endcomment -%}
    {%- if section.settings.show_live_row and section.settings.live_collection != blank -%}
      {%- assign live_products = collections[section.settings.live_collection].products -%}
      {%- if live_products.size > 0 -%}
