{% comment %}
  Section: Classified Intel Marquee Wall
  File: sections/armory-classified-intel.liquid
{% endcomment %}

<style>
/* ============================================================
   CLASSIFIED INTEL – MARQUEE WALL
   ============================================================ */

#aci-{{ section.id }} {
  --aci-accent: {{ section.settings.accent_color }};
  --aci-accent-rgb: 0, 212, 255;
  --aci-bg: {{ section.settings.bg_color }};
  --aci-font: 'Rajdhani', 'Orbitron', 'Courier New', monospace;

  position: relative;
  width: 100%;
  background: var(--aci-bg);
  padding: {{ section.settings.section_padding }}px 0;
  font-family: var(--aci-font);
  overflow: hidden;
  box-sizing: border-box;
}

/* ── Deep background radial glow ── */
#aci-{{ section.id }}::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 100%;
  background: radial-gradient(
    ellipse at center,
    rgba(var(--aci-accent-rgb), 0.06) 0%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
}

/* ── Grid overlay ── */
#aci-{{ section.id }}::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(var(--aci-accent-rgb), 0.028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--aci-accent-rgb), 0.028) 1px, transparent 1px);
  background-size: 44px 44px;
  pointer-events: none;
  z-index: 0;
}

/* ── Scanlines ── */
.aci-scanlines {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent, transparent 2px,
    rgba(0,0,0,0.15) 2px, rgba(0,0,0,0.15) 4px
  );
  pointer-events: none;
  z-index: 1;
  opacity: 0.4;
}

/* ── Top / bottom gradient fade edges ── */
.aci-fade-top,
.aci-fade-bottom {
  position: absolute;
  left: 0; right: 0;
  height: 80px;
  z-index: 5;
  pointer-events: none;
}

.aci-fade-top {
  top: 0;
  background: linear-gradient(to bottom, var(--aci-bg) 0%, transparent 100%);
}

.aci-fade-bottom {
  bottom: 0;
  background: linear-gradient(to top, var(--aci-bg) 0%, transparent 100%);
}

/* ── Left / right gradient fade ── */
.aci-fade-left,
.aci-fade-right {
  position: absolute;
  top: 0; bottom: 0;
  width: 200px;
  z-index: 5;
  pointer-events: none;
}

.aci-fade-left {
  left: 0;
  background: linear-gradient(to right, var(--aci-bg) 0%, transparent 100%);
}

.aci-fade-right {
  right: 0;
  background: linear-gradient(to left, var(--aci-bg) 0%, transparent 100%);
}

/* ============================================================
   SECTION HEADER
   ============================================================ */
.aci-header {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin-bottom: 48px;
  padding: 0 24px;
  text-align: center;
}

/* Classified stamp */
.aci-stamp {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.aci-stamp__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(var(--aci-accent-rgb), 0.06);
  border: 1px solid rgba(var(--aci-accent-rgb), 0.3);
  padding: 6px 16px 6px 12px;
  border-radius: 2px;
  position: relative;
  overflow: hidden;
  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
}

.aci-stamp__badge::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(var(--aci-accent-rgb), 0.08), transparent);
  animation: aciBadgeSweep 4s ease-in-out infinite;
}

@keyframes aciBadgeSweep {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

.aci-stamp__dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--aci-accent);
  box-shadow: 0 0 8px var(--aci-accent);
  animation: aciDotPulse 1.5s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes aciDotPulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 8px var(--aci-accent); }
  50% { opacity: 0.3; box-shadow: 0 0 3px var(--aci-accent); }
}

.aci-stamp__text {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--aci-accent);
  text-transform: uppercase;
  position: relative;
  z-index: 1;
}

/* Classified red stamp overlay */
.aci-stamp__classified {
  position: absolute;
  right: -60px;
  top: 50%;
  transform: translateY(-50%) rotate(-8deg);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.18em;
  color: rgba(255,50,50,0.55);
  border: 1.5px solid rgba(255,50,50,0.4);
  padding: 2px 8px;
  border-radius: 2px;
  text-transform: uppercase;
  white-space: nowrap;
  animation: aciClassifiedFlicker 4s ease-in-out infinite;
}

@keyframes aciClassifiedFlicker {
  0%, 90%, 100% { opacity: 0.55; }
  92% { opacity: 0.1; }
  94% { opacity: 0.55; }
  96% { opacity: 0.2; }
  98% { opacity: 0.55; }
}

.aci-title {
  font-size: clamp(28px, 4vw, 56px);
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  margin: 0;
  line-height: 1.05;
  text-shadow:
    0 0 40px rgba(var(--aci-accent-rgb), 0.3),
    0 2px 4px rgba(0,0,0,0.5);
}

.aci-title mark {
  background: none;
  color: var(--aci-accent);
  position: relative;
}

.aci-subtitle {
  font-size: 13px;
  color: rgba(180,210,240,0.5);
  letter-spacing: 0.08em;
  line-height: 1.7;
  max-width: 500px;
  margin: 0;
}

/* Header HUD lines */
.aci-header__hud {
  display: flex;
  align-items: center;
  gap: 8px;
}

.aci-header__hud-line {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(var(--aci-accent-rgb), 0.5), transparent);
  width: 60px;
}

.aci-header__hud-diamond {
  width: 5px; height: 5px;
  background: var(--aci-accent);
  transform: rotate(45deg);
  box-shadow: 0 0 8px var(--aci-accent);
}

/* ============================================================
   MARQUEE ROWS CONTAINER
   ============================================================ */
.aci-rows {
  position: relative;
  z-index: 4;
  display: flex;
  flex-direction: column;
  gap: {{ section.settings.row_gap }}px;
}

/* ============================================================
   SINGLE MARQUEE ROW
   ============================================================ */
.aci-row {
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: {{ section.settings.row_padding }}px 0;
}

/* Row border lines */
.aci-row::before,
.aci-row::after {
  content: '';
  position: absolute;
  left: 0; right: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(var(--aci-accent-rgb), 0.12) 20%,
    rgba(var(--aci-accent-rgb), 0.22) 50%,
    rgba(var(--aci-accent-rgb), 0.12) 80%,
    transparent 100%
  );
}

.aci-row::before { top: 0; }
.aci-row::after  { bottom: 0; }

/* Row accent glow line on active */
.aci-row--glowing::before {
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(var(--aci-accent-rgb), 0.6) 50%,
    transparent 100%
  );
  box-shadow: 0 0 12px rgba(var(--aci-accent-rgb), 0.3);
}

/* ── Marquee track ── */
.aci-track {
  display: flex;
  align-items: center;
  white-space: nowrap;
  gap: 0;
  will-change: transform;
}

/* Forward direction */
.aci-track--fwd {
  animation: aciMarqueeFwd var(--row-speed, 30s) linear infinite;
}

/* Reverse direction */
.aci-track--rev {
  animation: aciMarqueeRev var(--row-speed, 35s) linear infinite;
}

/* Pause on hover */
.aci-row:hover .aci-track { animation-play-state: paused; }

@keyframes aciMarqueeFwd {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@keyframes aciMarqueeRev {
  0%   { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

/* ============================================================
   MARQUEE ITEM
   ============================================================ */
.aci-item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 0 20px;
  user-select: none;
  flex-shrink: 0;
}

/* Item text */
.aci-item__text {
  font-size: var(--row-font-size, 13px);
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
  line-height: 1;
  transition: color 0.2s ease;
}

/* Color variants */
.aci-item--cyan   .aci-item__text { color: rgba(0,212,255,0.75); }
.aci-item--white  .aci-item__text { color: rgba(255,255,255,0.55); }
.aci-item--dim    .aci-item__text { color: rgba(180,210,240,0.35); }
.aci-item--accent .aci-item__text { color: var(--aci-accent); }
.aci-item--red    .aci-item__text { color: rgba(255,80,80,0.6); }
.aci-item--green  .aci-item__text { color: rgba(0,255,136,0.65); }
.aci-item--gold   .aci-item__text { color: rgba(255,215,0,0.65); }
.aci-item--purple .aci-item__text { color: rgba(180,77,255,0.7); }

.aci-row:hover .aci-item__text {
  color: #ffffff !important;
}

/* Item separator / icon */
.aci-item__sep {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  opacity: 0.5;
}

/* Separator variants */
.aci-sep--dot {
  width: 4px; height: 4px;
  border-radius: 50%;
  background: var(--aci-accent);
  box-shadow: 0 0 6px var(--aci-accent);
}

.aci-sep--diamond {
  width: 5px; height: 5px;
  background: currentColor;
  transform: rotate(45deg);
}

.aci-sep--slash {
  font-size: 10px;
  font-weight: 400;
  color: rgba(var(--aci-accent-rgb), 0.3);
  letter-spacing: 0;
}

.aci-sep--line {
  width: 20px; height: 1px;
  background: rgba(var(--aci-accent-rgb), 0.3);
}

.aci-sep--chevron {
  font-size: 10px;
  color: rgba(var(--aci-accent-rgb), 0.4);
}

/* ── HIGHLIGHTED item (stands out) ── */
.aci-item--highlight {
  background: rgba(var(--aci-accent-rgb), 0.08);
  border: 1px solid rgba(var(--aci-accent-rgb), 0.2);
  border-radius: 2px;
  padding: 4px 14px;
  margin: 0 8px;
  clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
  position: relative;
  overflow: hidden;
}

.aci-item--highlight::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(var(--aci-accent-rgb), 0.06), transparent);
  animation: aciHighlightSweep 3s ease-in-out infinite;
}

@keyframes aciHighlightSweep {
  0%, 100% { transform: translateX(-100%); }
  50% { transform: translateX(100%); }
}

.aci-item--highlight .aci-item__text {
  color: var(--aci-accent) !important;
  text-shadow: 0 0 12px rgba(var(--aci-accent-rgb), 0.5);
}

/* ── CLASSIFIED stamp item ── */
.aci-item--classified .aci-item__text {
  color: rgba(255,50,50,0.55) !important;
  border: 1px solid rgba(255,50,50,0.3);
  padding: 2px 8px;
  border-radius: 1px;
  animation: aciRedFlicker 6s ease-in-out infinite;
}

@keyframes aciRedFlicker {
  0%, 85%, 100% { opacity: 0.55; }
  87% { opacity: 0.1; }
  89% { opacity: 0.55; }
  91% { opacity: 0.15; }
  93% { opacity: 0.55; }
}

/* ── NEW badge item ── */
.aci-item--new::after {
  content: 'NEW';
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: #050b15;
  background: var(--aci-accent);
  padding: 1px 5px;
  border-radius: 1px;
  margin-left: 6px;
  box-shadow: 0 0 6px var(--aci-accent);
}

/* ── Price item ── */
.aci-item--price .aci-item__text {
  color: rgba(0,255,136,0.7) !important;
}

/* ============================================================
   ROW LABEL (left side fixed label)
   ============================================================ */
.aci-row__label {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 8;
  background: var(--aci-bg);
  padding: 4px 16px 4px 20px;
  display: flex;
  flex-direction: column;
  gap: 1px;
  pointer-events: none;
}

.aci-row__label-num {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.2em;
  color: rgba(var(--aci-accent-rgb), 0.4);
}

.aci-row__label-text {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: rgba(255,255,255,0.2);
  text-transform: uppercase;
}

/* ============================================================
   CENTER DIVIDER (between rows)
   ============================================================ */
.aci-row-divider {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 4px 0;
}

.aci-row-divider__line {
  flex: 1;
  height: 1px;
  max-width: 120px;
  background: linear-gradient(90deg, transparent, rgba(var(--aci-accent-rgb), 0.2));
}

.aci-row-divider__line:last-child {
  background: linear-gradient(90deg, rgba(var(--aci-accent-rgb), 0.2), transparent);
}

.aci-row-divider__icon {
  color: rgba(var(--aci-accent-rgb), 0.3);
  display: flex;
  align-items: center;
}

/* ============================================================
   TERMINAL READOUT (center overlay panel)
   ============================================================ */
.aci-terminal {
  position: relative;
  z-index: 10;
  margin: 40px auto 0;
  max-width: 700px;
  padding: 0 24px;
}

.aci-terminal__panel {
  background: rgba(5, 11, 21, 0.9);
  border: 1px solid rgba(var(--aci-accent-rgb), 0.2);
  border-radius: 4px;
  padding: 24px;
  position: relative;
  overflow: hidden;
  clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

/* Top accent line */
.aci-terminal__panel::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--aci-accent), rgba(var(--aci-accent-rgb), 0.3), transparent);
}

/* Grid bg */
.aci-terminal__panel::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(var(--aci-accent-rgb), 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--aci-accent-rgb), 0.03) 1px, transparent 1px);
  background-size: 20px 20px;
  pointer-events: none;
}

.aci-terminal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
  position: relative;
  z-index: 1;
}

.aci-terminal__title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: var(--aci-accent);
  text-transform: uppercase;
}

.aci-terminal__title-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--aci-accent);
  box-shadow: 0 0 8px var(--aci-accent);
  animation: aciDotPulse 1.5s ease-in-out infinite;
}

.aci-terminal__controls {
  display: flex;
  gap: 5px;
}

.aci-terminal__ctrl {
  width: 8px; height: 8px;
  border-radius: 50%;
}

.aci-terminal__ctrl:nth-child(1) { background: rgba(255,80,80,0.5); }
.aci-terminal__ctrl:nth-child(2) { background: rgba(255,215,0,0.5); }
.aci-terminal__ctrl:nth-child(3) { background: rgba(0,255,136,0.5); }

/* Terminal lines */
.aci-terminal__body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: relative;
  z-index: 1;
}

.aci-terminal__line {
  display: flex;
  align-items: baseline;
  gap: 10px;
  font-size: 11px;
  letter-spacing: 0.06em;
  opacity: 0;
  animation: aciTermLineIn 0.4s ease forwards;
}

.aci-terminal__line:nth-child(1)  { animation-delay: 0.2s; }
.aci-terminal__line:nth-child(2)  { animation-delay: 0.5s; }
.aci-terminal__line:nth-child(3)  { animation-delay: 0.8s; }
.aci-terminal__line:nth-child(4)  { animation-delay: 1.1s; }
.aci-terminal__line:nth-child(5)  { animation-delay: 1.4s; }
.aci-terminal__line:nth-child(6)  { animation-delay: 1.7s; }

@keyframes aciTermLineIn {
  from { opacity: 0; transform: translateX(-6px); }
  to   { opacity: 1; transform: translateX(0); }
}

.aci-terminal__prompt {
  color: var(--aci-accent);
  font-weight: 800;
  flex-shrink: 0;
  font-size: 12px;
}

.aci-terminal__cmd {
  color: rgba(255,255,255,0.8);
  font-weight: 600;
}

.aci-terminal__output {
  color: rgba(0,255,136,0.7);
  font-weight: 600;
}

.aci-terminal__comment {
  color: rgba(180,210,240,0.3);
  font-size: 10px;
}

.aci-terminal__error {
  color: rgba(255,80,80,0.65);
  font-weight: 600;
}

/* Cursor blink */
.aci-terminal__cursor {
  display: inline-block;
  width: 7px;
  height: 13px;
  background: var(--aci-accent);
  animation: aciCursorBlink 1s step-end infinite;
  vertical-align: text-bottom;
  border-radius: 1px;
}

@keyframes aciCursorBlink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0; }
}

/* ============================================================
   STAT COUNTERS ROW (below terminal)
   ============================================================ */
.aci-stats-row {
  position: relative;
  z-index: 10;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  margin: 40px 24px 0;
  background: rgba(var(--aci-accent-rgb), 0.1);
  border: 1px solid rgba(var(--aci-accent-rgb), 0.15);
  border-radius: 4px;
  overflow: hidden;
  clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
}

.aci-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 12px;
  background: rgba(5,11,21,0.85);
  gap: 5px;
  position: relative;
  transition: background 0.3s ease;
  cursor: default;
}

.aci-stat:hover { background: rgba(5,11,21,0.65); }

.aci-stat + .aci-stat {
  border-left: 1px solid rgba(var(--aci-accent-rgb), 0.1);
}

/* Top accent micro-line on hover */
.aci-stat::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1.5px;
  background: var(--aci-accent);
  opacity: 0;
  transition: opacity 0.3s ease;
  box-shadow: 0 0 8px var(--aci-accent);
}

.aci-stat:hover::before { opacity: 1; }

.aci-stat__val {
  font-size: 26px;
  font-weight: 800;
  color: var(--aci-accent);
  line-height: 1;
  text-shadow: 0 0 20px rgba(var(--aci-accent-rgb), 0.5);
  letter-spacing: 0.02em;
}

.aci-stat__label {
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: rgba(255,255,255,0.25);
  text-transform: uppercase;
  text-align: center;
}

/* ============================================================
   HUD CORNER DECORATIONS
   ============================================================ */
.aci-hud-corner {
  position: absolute;
  width: 16px; height: 16px;
  pointer-events: none;
  z-index: 6;
  opacity: 0.35;
}

.aci-hud-corner--tl { top: 12px; left: 12px; border-top: 1.5px solid var(--aci-accent); border-left: 1.5px solid var(--aci-accent); }
.aci-hud-corner--tr { top: 12px; right: 12px; border-top: 1.5px solid var(--aci-accent); border-right: 1.5px solid var(--aci-accent); }
.aci-hud-corner--bl { bottom: 12px; left: 12px; border-bottom: 1.5px solid var(--aci-accent); border-left: 1.5px solid var(--aci-accent); }
.aci-hud-corner--br { bottom: 12px; right: 12px; border-bottom: 1.5px solid var(--aci-accent); border-right: 1.5px solid var(--aci-accent); }

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 768px) {
  #aci-{{ section.id }} { padding: 48px 0; }
  .aci-fade-left,
  .aci-fade-right { width: 60px; }
  .aci-header { margin-bottom: 36px; }
  .aci-stamp__classified { display: none; }
  .aci-stats-row { grid-template-columns: repeat(2, 1fr); margin: 32px 16px 0; }
  .aci-stat + .aci-stat { border-left: none; }
  .aci-stat:nth-child(2n+1) { border-right: 1px solid rgba(var(--aci-accent-rgb), 0.1); }
  .aci-stat:nth-child(n+3) { border-top: 1px solid rgba(var(--aci-accent-rgb), 0.1); }
  .aci-terminal { padding: 0 16px; }
  .aci-item__text { font-size: 11px !important; }
  .aci-hud-corner { display: none; }
}

@media (max-width: 480px) {
  .aci-stats-row { grid-template-columns: repeat(2, 1fr); }
  .aci-title { font-size: 26px; }
  .aci-terminal__line { font-size: 10px; }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .aci-track { animation: none !important; }
  .aci-stamp__badge::before,
  .aci-item--highlight::before { animation: none !important; }
  .aci-terminal__line { animation: none !important; opacity: 1 !important; }
}
</style>


<section
  id="aci-{{ section.id }}"
  data-section-id="{{ section.id }}"
  aria-label="Classified Intel"
