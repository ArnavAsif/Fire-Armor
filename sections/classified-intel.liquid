    <div class="aci-stamp">
      <div class="aci-stamp__badge">
        <span class="aci-stamp__dot" aria-hidden="true"></span>
        <span class="aci-stamp__text">{{ section.settings.badge | default: 'CLASSIFIED INTEL' }}</span>
      </div>
      <span class="aci-stamp__classified" aria-hidden="true">TOP SECRET</span>
    </div>

    {%- if section.settings.title != blank -%}
      <h2 class="aci-title">
        {{- section.settings.title | replace: section.settings.title_accent, '<mark>' | append: '</mark>' -}}
